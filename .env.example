# JUNKMAN uses Nightwatch through YEHANGSHE_API_KEY in the Windows user
# environment. Never put the API key in this file, .env, source code, or logs.

# Moomoo OpenD WebSocket connection
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_WS_PORT=33333
MOOMOO_OPEND_WS_SSL=false
# All processes read the same OpenD credential file. Do not set a second direct key.
MOOMOO_OPEND_WS_KEY_FILE=./secrets/moomoo_opend_ws_key.txt

# JUNKMAN is simulation-only. Keep both values unchanged.
MOOMOO_TRD_ENV=simulate
MOOMOO_TRD_MARKET=US
MOOMOO_ALLOW_REAL_TRADING=false

# Quote push warmup and bounded snapshot fallback used by JUNKMAN execution.
MOOMOO_QUOTE_PUSH_WARMUP_MS=350
MOOMOO_QUOTE_FALLBACK_SNAPSHOT_MAX_AGE_MS=2000

# Optional local policy override for diagnostics. Normal JUNKMAN entrypoints pass
# config/zero-dte-options-policy.json explicitly; leave this unset in normal use.
# MOOMOO_POLICY_FILE=./config/zero-dte-options-policy.json
