{
  "name": "atr_stop_live_risk_control",
  "version": 1,
  "business_line": {
    "id": "atr-stop",
    "status": "active",
    "description": "Real-account ATR trailing-stop risk-control line. It manages exits for current stock holdings and does not select or rebalance stocks."
  },
  "execution": {
    "broker": "moomoo_opend",
    "environment": "real_account_with_confirmations",
    "real_trading_allowed": true,
    "ai_decisioning_allowed": false,
    "external_model_calls_allowed": false,
    "decision_engine": "local_deterministic_program"
  },
  "risk_control": {
    "atr_period_default": 21,
    "atr_multiplier_default": 2.5,
    "atr_method": "wilder",
    "price_basis": "adjusted_ohlc",
    "max_initial_loss_pct_default": 12,
    "breakeven_enabled_default": true,
    "profit_protection_enabled_default": true,
    "does_not_select_stocks": true,
    "does_not_read_rebalance_targets": true
  }
}
