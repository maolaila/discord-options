{
  "name": "junk_man_top100_multi_0dte_simulation",
  "version": 1,
  "business_line": {
    "id": "junk-multi-options",
    "status": "active_simulation",
    "description": "Independent JUNKMAN multi-symbol 0DTE simulation. Moomoo options-volume Top100 seeds the universe; only current Nightwatch-supported tickers with a real same-day option chain can become finalists."
  },
  "execution": {
    "broker": "moomoo_opend",
    "environment": "simulate_only",
    "real_trading_allowed": false,
    "ai_decisioning_allowed": false,
    "external_model_calls_allowed": false,
    "decision_engine": "local_deterministic_program"
  },
  "provider": {
    "name": "nightwatch",
    "base_url": "https://api.yehangshe.com",
    "api_key_env": "YEHANGSHE_API_KEY",
    "fixed_sample_interval_seconds": 300,
    "snapshot_min_interval_ms": 1000,
    "max_429_retries": 0,
    "request_timeout_ms": 10000
  },
  "universe": {
    "source": "moomoo_opend_get_option_underlying_rank",
    "rank_sort": "options_volume_desc",
    "rank_count": 100,
    "require_previous_completed_nyse_trading_date": true,
    "nightwatch_working_set": "dealer-heatmap",
    "nightwatch_coverage_required": true,
    "zero_dte_chain_required": true,
    "reserved_underlyings": ["SPX"],
    "finalist_limit": 10,
    "max_option_chain_probes": 100,
    "refresh_time_et": "08:45"
  },
  "strategy": {
    "id": "junk_gex_nodes_v3",
    "flow_dependency": "none",
    "manual_discord_flow_allowed": false,
    "allowed_snapshot_states": ["fresh"],
    "max_snapshot_age_ms": 600000,
    "require_exact_fixed_sample_bucket": true,
    "closed_bar_interval_ms": 300000,
    "closed_bar_interval_tolerance_ms": 1000,
    "require_volume_confirmation": true,
    "option_expiry_days": 0,
    "option_strike_offset_steps": 1,
    "entry_start_time_et": "09:35",
    "entry_cutoff_time_et": "15:30",
    "cooldown_seconds": 0,
    "require_heatmap_snapshot": true,
    "require_heatmap_confirmation": false
  },
  "evidence_gates": {
    "heatmap": {
      "enabled": true,
      "max_age_ms": 600000,
      "direction_from_price_reaction_only": true,
      "missing_or_degraded_is_neutral": false,
      "fresh_snapshot_required_for_entry": true,
      "exact_node_confirmation_required": false
    },
    "contract_confirmation": {
      "source": "moomoo_execution_quote_with_nightwatch_directional_chain",
      "enabled": true,
      "nightwatch_endpoint": "options.chain_snapshot",
      "allowed_states": ["fresh"],
      "audit_max_age_ms": 600000,
      "require_bid_ask": true,
      "require_open_interest_and_volume": true,
      "service_unavailable_is_neutral": false
    },
    "oi_structure_background": {
      "enabled": false,
      "usage": "not_ported_from_spx"
    }
  },
  "market_calendar": {
    "source": "cboe_us_options_2026",
    "valid_through_et": "2026-12-31",
    "closed_dates_et": [
      "2026-01-01", "2026-01-19", "2026-02-16", "2026-04-03",
      "2026-05-25", "2026-06-19", "2026-07-03", "2026-09-07",
      "2026-11-26", "2026-12-25"
    ],
    "early_close_dates_et": ["2026-11-27", "2026-12-24"],
    "early_close_exit_start_time_et": "12:30",
    "early_force_close_exit_start_time_et": "12:45",
    "early_session_close_time_et": "13:00"
  },
  "risk_limits": {
    "allowed_underlyings": [],
    "allowed_underlyings_source": "validated_top100_nightwatch_0dte_finalists",
    "max_signal_age_seconds": 30,
    "max_gex_snapshot_age_seconds": 600,
    "max_future_clock_skew_seconds": 5,
    "max_option_quote_age_seconds": 3,
    "max_open_positions": 1,
    "max_trades_per_day": null,
    "max_daily_realized_loss_usd": null,
    "entry_order_ttl_seconds": 45
  },
  "position_sizing": {
    "paper_equity_usd": 10000,
    "target_position_pct": 5,
    "min_position_pct": 1,
    "max_position_pct": 10,
    "contract_multiplier_default": 100
  },
  "exit_experiment": {
    "enabled": true,
    "experiment_id": "junk_multi_exit_grid_v1",
    "version": 1,
    "paired_entry": true,
    "broker_execution_mode": "aggregate_single_position",
    "paper_equity_usd_per_line": 10000,
    "description": "Seven independent $10,000 virtual portfolios share one aggregate moomoo simulated position and differ only by fixed option stop/take-profit rules.",
    "lines": [
      {
        "line_id": "control_sl15_tp_off", "label": "Control SL15 TP off", "control": true,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 15,
        "option_take_profit_enabled": false, "option_take_profit_pct": 25
      },
      {
        "line_id": "sl10_tp_off", "label": "SL10 TP off", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 10,
        "option_take_profit_enabled": false, "option_take_profit_pct": 25
      },
      {
        "line_id": "sl10_tp20", "label": "SL10 TP20", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 10,
        "option_take_profit_enabled": true, "option_take_profit_pct": 20
      },
      {
        "line_id": "sl10_tp30", "label": "SL10 TP30", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 10,
        "option_take_profit_enabled": true, "option_take_profit_pct": 30
      },
      {
        "line_id": "sl15_tp20", "label": "SL15 TP20", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 15,
        "option_take_profit_enabled": true, "option_take_profit_pct": 20
      },
      {
        "line_id": "sl15_tp30", "label": "SL15 TP30", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 15,
        "option_take_profit_enabled": true, "option_take_profit_pct": 30
      },
      {
        "line_id": "sl12p5_tp25", "label": "SL12.5 TP25", "control": false,
        "paper_equity_usd": 10000, "catastrophic_stop_loss_pct": 12.5,
        "option_take_profit_enabled": true, "option_take_profit_pct": 25
      }
    ]
  },
  "execution_quality": {
    "quote_source": "opend_push_orderbook_with_snapshot_fallback",
    "require_bid_ask": true,
    "require_tick_size": true,
    "require_open_interest_and_volume": true,
    "min_bid_price": 0.05,
    "max_spread_pct_of_mid": 20,
    "max_spread_abs": null,
    "max_round_trip_loss_pct": 25,
    "buy_limit_basis": "ask_plus_slippage_buffer",
    "sell_estimate_basis": "bid_minus_slippage_buffer",
    "slippage_ticks": 1,
    "slippage_pct_of_spread": 0,
    "cap_qty_by_visible_ask": true,
    "max_qty_to_ask_volume_ratio": 1,
    "min_open_interest": 100,
    "min_option_day_volume": 100
  },
  "exit_rules": {
    "price_basis": "option_entry_fill_price",
    "option_price_exit": true,
    "option_take_profit_enabled": false,
    "option_take_profit_pct": 25,
    "option_stop_loss_pct": 15,
    "catastrophic_stop_loss_pct": 15,
    "breakeven_activation_pct": 20,
    "breakeven_floor_pct": 0,
    "setup_time_stop_enabled": true,
    "setup_time_stop_minutes": 5,
    "setup_time_stop_setup_types": ["range_mean_reversion"],
    "structural_target_partial_exit_enabled": true,
    "structural_target_partial_exit_ratio": 0.5,
    "structural_target_profit_floor_pct": 0,
    "use_underlying_confirmation_bar_wick_invalidation": true,
    "use_next_gex_node_target": true,
    "exit_before_regular_session_close": true,
    "close_exit_start_time_et": "15:45",
    "force_close_exit_start_time_et": "15:55",
    "no_overnight_holding": true,
    "controlled_overnight": {"enabled": false}
  },
  "logging": {
    "prefix": "junk-multi-options",
    "strategy_label": "JUNKMAN-MULTI",
    "separate_from_spx_junkman": true,
    "separate_from_pa_options": true
  }
}
