{
  "name": "stock_rebalance_live",
  "version": 1,
  "business_line": {
    "id": "stock-rebalance",
    "status": "active",
    "description": "Stock rebalance line. Reads local target CSV and submits real-account stock orders only after explicit confirmations."
  },
  "execution": {
    "broker": "moomoo_opend",
    "environment": "real_account_with_confirmations",
    "real_trading_allowed": true,
    "ai_decisioning_allowed": false,
    "external_model_calls_allowed": false,
    "decision_engine": "local_deterministic_program"
  },
  "order_policy": {
    "target_invested_pct_default": 100,
    "regular_session_order_type": "MARKET",
    "extended_hours_order_type": "LIMIT",
    "extended_hours_fill_outside_rth": true,
    "limit_buffer_pct_default": 0.25,
    "sell_phase_before_buy_phase": true,
    "skip_buy_phase_if_sell_phase_incomplete": true
  }
}
