{
  "name": "junkman-spx-0dte-sim",
  "version": "1.0.0",
  "private": true,
  "description": "JUNKMAN SPX 0DTE simulation using Nightwatch evidence and moomoo OpenD.",
  "main": "apps/zero-dte-options/zero-dte-line.mjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "capture": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-capture.ps1",
    "moomoo:check": "node ./apps/opend-check/moomoo-check.mjs",
    "nightwatch:discover": "node ./apps/zero-dte-options/zero-dte-line.mjs --discover",
    "junk:gex:status": "node ./apps/zero-dte-options/zero-dte-line.mjs --status",
    "junk:gex:plan": "node ./apps/zero-dte-options/zero-dte-line.mjs --dry-run",
    "junk:gex:watch-plan": "node ./apps/zero-dte-options/zero-dte-line.mjs --watch --dry-run",
    "junk:gex:simulate": "node ./apps/zero-dte-options/zero-dte-line.mjs --execute-simulate",
    "junk:gex:watch-sim": "node ./apps/zero-dte-options/zero-dte-line.mjs --watch --execute-simulate",
    "junk:multi:status": "node ./apps/junk-multi-options/junk-multi-line.mjs --status",
    "junk:multi:plan": "node ./apps/junk-multi-options/junk-multi-line.mjs --dry-run",
    "junk:multi:watch-plan": "node ./apps/junk-multi-options/junk-multi-line.mjs --watch --dry-run",
    "junk:multi:simulate": "node ./apps/junk-multi-options/junk-multi-line.mjs --execute-simulate",
    "junk:multi:watch-sim": "node ./apps/junk-multi-options/junk-multi-line.mjs --watch --execute-simulate",
    "junk:flow-heatmap:status": "node ./apps/junk-flow-heatmap-options/junk-flow-heatmap-line.mjs --status",
    "junk:flow-heatmap:plan": "node ./apps/junk-flow-heatmap-options/junk-flow-heatmap-line.mjs --dry-run",
    "junk:flow-heatmap:watch-plan": "node ./apps/junk-flow-heatmap-options/junk-flow-heatmap-line.mjs --watch --dry-run",
    "junk:flow-heatmap:simulate": "node ./apps/junk-flow-heatmap-options/junk-flow-heatmap-line.mjs --execute-simulate",
    "junk:flow-heatmap:watch-sim": "node ./apps/junk-flow-heatmap-options/junk-flow-heatmap-line.mjs --watch --execute-simulate",
    "zero-dte:status": "npm run junk:gex:status",
    "zero-dte:plan": "npm run junk:gex:plan",
    "console": "node ./apps/control-console/control-console.mjs",
    "review:junk-post-deploy": "node ./ops/write-junk-post-deploy-summary.mjs",
    "review:export": "node ./ops/export-review-data.mjs",
    "onchain:status": "node ./apps/trade-notary/trade-notary-cli.mjs status",
    "onchain:dry-run": "node ./apps/trade-notary/trade-notary-cli.mjs dry-run",
    "onchain:publish": "node ./apps/trade-notary/trade-notary-cli.mjs publish",
    "test": "node --test \"./tests/*.mjs\" \"./tests/*.cjs\" \"./apps/zero-dte-options/*.test.mjs\""
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "moomoo-api": "10.9.6908",
    "playwright-core": "^1.54.0",
    "ws": "^8.21.0"
  }
}
