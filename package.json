{
  "name": "discord-web-message-capture",
  "version": "1.0.0",
  "private": true,
  "description": "Capture Discord web gateway message events from a local browser session.",
  "main": "apps/discord-capture/capture-discord.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "capture": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-capture.ps1",
    "moomoo:check": "node ./apps/opend-check/moomoo-check.mjs",
    "pa:options-plan": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --dry-run",
    "pa:options-watch-plan": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --dry-run",
    "pa:options-simulate": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --execute-simulate",
    "pa:options-watch-sim": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --execute-simulate",
    "pa:options-real": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --execute-real",
    "pa:options-watch-real": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --execute-real",
    "pa:options-exit-once": "node ./apps/options-sim/moomoo-exit-monitor.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json",
    "pa:options-exit-watch": "node ./apps/options-sim/moomoo-exit-monitor.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch",
    "pa:options-exit-real-watch": "node ./apps/options-sim/moomoo-exit-monitor.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --execute-real",
    "zero-dte:status": "node ./apps/zero-dte-options/zero-dte-line.mjs --status",
    "zero-dte:plan": "node ./apps/zero-dte-options/zero-dte-line.mjs --plan-only",
    "moomoo:plan": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --dry-run",
    "moomoo:watch-plan": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --dry-run",
    "moomoo:simulate": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --execute-simulate",
    "moomoo:watch-sim": "node ./apps/options-sim/moomoo-signal-trader.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch --execute-simulate",
    "moomoo:exit-once": "node ./apps/options-sim/moomoo-exit-monitor.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json",
    "moomoo:exit-watch": "node ./apps/options-sim/moomoo-exit-monitor.mjs --business-line pa-options --policy-file ./config/pa-options-policy.json --watch",
    "moomoo:order-smoke": "node ./apps/opend-check/order-smoke-test.mjs --execute-real",
    "stock:rebalance-plan": "node ./apps/stock-rebalance/stock-rebalance-live.mjs --plan-only",
    "stock:rebalance-live": "node ./apps/stock-rebalance/stock-rebalance-live.mjs --wait-open --execute-real",
    "stock:rebalance-extended": "node ./apps/stock-rebalance/stock-rebalance-live.mjs --extended-hours --execute-real",
    "atr:stop-refresh": "node ./apps/atr-stop/atr-trailing-stop.mjs --business-line atr-stop --policy-file ./config/atr-stop-policy.json --refresh-only",
    "atr:stop-watch": "node ./apps/atr-stop/atr-trailing-stop.mjs --business-line atr-stop --policy-file ./config/atr-stop-policy.json --watch --execute-real",
    "console": "node ./apps/control-console/control-console.mjs",
    "test": "node --test \"./tests/*.mjs\" \"./tests/*.cjs\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "moomoo-api": "file:vendor/MMAPI4JS_10.6.6608/src",
    "playwright-core": "^1.54.0",
    "ws": "^8.21.0"
  }
}
